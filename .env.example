# From Supabase: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Time zone used to display timestamps
APP_TIMEZONE=America/New_York

# Valor payment terminals (optional). Without these, terminal charges use the built-in simulator.
# Get the endpoint, App ID and App Key from Valor once Valor Connect is enabled for your terminals.
VALOR_MODE=simulator
VALOR_CONNECT_URL=
VALOR_APP_ID=
VALOR_APP_KEY=
# For the optional webhook at /api/valor/webhook
VALOR_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
